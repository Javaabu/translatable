{
    "name": "javaabu/translatable",
    "description": "Multi-lingual Eloquent models for Laravel, stored as rows per locale or as JSON, with Blade and Inertia React components",
    "homepage": "https://github.com/Javaabu/translatable",
    "license": "MIT",
    "keywords": [
        "javaabu",
        "laravel",
        "translatable",
        "translations",
        "multilingual",
        "i18n",
        "dhivehi",
        "rtl"
    ],
    "authors": [
        {
            "name": "Xylam",
            "email": "jailam@javaabu.com",
            "role": "Developer"
        },
        {
            "name": "FlameXode",
            "email": "hi@flamexo.de",
            "role": "Developer"
        },
        {
            "name": "Athphane",
            "email": "athphane@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "inertiajs/inertia-laravel": "^2.0 || ^3.0",
        "javaabu/boost-javaabu-guidelines": "^1.4",
        "javaabu/forms": "^2.0@dev",
        "javaabu/helpers": "^1.74",
        "javaabu/manifest": "^1.0@dev",
        "laravel/pint": "^1.25",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.3 || ^12.5.8",
        "symfony/css-selector": "^7.2 || ^8.0",
        "symfony/dom-crawler": "^7.2 || ^8.0"
    },
    "suggest": {
        "javaabu/forms": "Required for the Blade components (^2.0)",
        "javaabu/manifest": "Ships the Inertia React components to your app (^1.0)",
        "inertiajs/inertia-laravel": "Shares the languages with Inertia pages when translatable.views is inertia (^2.0)",
        "javaabu/helpers": "Use Javaabu\\Translatable\\Models\\AdminLanguage as the language model to get helpers' AdminModel (^1.74)"
    },
    "autoload": {
        "psr-4": {
            "Javaabu\\Translatable\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Javaabu\\Translatable\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-clover=clover.xml",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "branch-alias": {
            "dev-next-gen": "3.x-dev"
        },
        "laravel": {
            "providers": [
                "Javaabu\\Translatable\\TranslatableServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/forms",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/Javaabu/manifest",
            "no-api": true
        }
    ]
}
